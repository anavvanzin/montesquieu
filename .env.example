# Server-side Gemini API key (automatically injected by AI Studio runtime)
GEMINI_API_KEY=
PORT=3000

# Canonical domain configuration for deployed website and Open Graph URLs (defaults to https://montesquieu.anavanzin.com)
CANONICAL_DOMAIN=https://montesquieu.anavanzin.com
SITE_URL=https://montesquieu.anavanzin.com

# Target portfolio address for return links and breadcrumbs (defaults to https://www.anavanzin.com/projetos)
PORTFOLIO_URL=https://www.anavanzin.com/projetos
